# Firebase web app config (Firebase console → Project settings → Your apps).
# Locally: copy this file to `.env.local`. On Netlify: add them under Site settings → Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional TURN server for users behind strict NATs/firewalls (STUN alone works for most networks).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
